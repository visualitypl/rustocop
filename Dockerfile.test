FROM ubuntu:24.04

# Each ARG is declared just before the step that uses it: a build argument
# is part of the cache key of every RUN after its declaration, and a new gem
# pin, nextest version or RuboCop revision should not rebuild the Rubies.
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    RUBOCOP_SRC=/opt/rubocop \
    CARGO_TARGET_DIR=/target \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_DEV_DEBUG=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libclang-dev \
        libffi-dev \
        libgmp-dev \
        libssl-dev \
        libyaml-dev \
        ruby \
        ruby-dev \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Before the Rubies: their configure builds YJIT and ZJIT only when it finds
# rustc, and the tests observe the difference.
ARG RUST_VERSION=1.99
RUN curl -fsSL https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain "$RUST_VERSION" --component clippy,rustfmt

ARG RUBY34_VERSION=3.4.1
RUN curl -fsSL "https://cache.ruby-lang.org/pub/ruby/${RUBY34_VERSION%.*}/ruby-${RUBY34_VERSION}.tar.gz" \
    | tar -xz -C /tmp \
    && cd "/tmp/ruby-${RUBY34_VERSION}" \
    && ./configure --prefix="/opt/ruby-${RUBY34_VERSION}" --disable-install-doc \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf "/tmp/ruby-${RUBY34_VERSION}"
ENV RUSTOCOP_RUBY34=/opt/ruby-${RUBY34_VERSION}/bin/ruby

ARG RUBY40_VERSION=4.0.9
RUN curl -fsSL "https://cache.ruby-lang.org/pub/ruby/${RUBY40_VERSION%.*}/ruby-${RUBY40_VERSION}.tar.gz" \
    | tar -xz -C /tmp \
    && cd "/tmp/ruby-${RUBY40_VERSION}" \
    && ./configure --prefix="/opt/ruby-${RUBY40_VERSION}" --disable-install-doc \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf "/tmp/ruby-${RUBY40_VERSION}"
ENV RUSTOCOP_RUBY40=/opt/ruby-${RUBY40_VERSION}/bin/ruby

# RuboCop for the system Ruby, which the oracle and the generators run. Its
# dependencies are pinned too (json and racc are the system Ruby's), because
# a newer one changes what RuboCop reports, and with it the tests' reference.
RUN gem install --no-document --ignore-dependencies \
        ast:2.4.3 \
        language_server-protocol:3.17.0.6 \
        lint_roller:1.1.0 \
        parallel:1.28.0 \
        parser:3.3.14.0 \
        prism:1.9.0 \
        rainbow:3.1.1 \
        regexp_parser:2.13.4 \
        rubocop-ast:1.54.0 \
        ruby-progressbar:1.13.0 \
        unicode-display_width:3.3.0 \
        unicode-emoji:4.3.0 \
    && gem install --no-document --conservative rubocop:1.92.0 \
    && ruby -e 'gem "rubocop", "1.92.0"; require "rubocop"'

ARG NEXTEST_VERSION=0.9.151
RUN case "$(uname -m)" in aarch64) platform=linux-arm ;; *) platform=linux ;; esac \
    && curl -fsSL "https://get.nexte.st/${NEXTEST_VERSION}/${platform}" \
    | tar -xz -C "$CARGO_HOME/bin"

ARG RUBOCOP_REVISION
RUN git init -q "$RUBOCOP_SRC" \
    && git -C "$RUBOCOP_SRC" fetch -q --depth 1 https://github.com/rubocop/rubocop.git "$RUBOCOP_REVISION" \
    && git -C "$RUBOCOP_SRC" checkout -q FETCH_HEAD

WORKDIR /work
CMD ["tools/check.sh"]
